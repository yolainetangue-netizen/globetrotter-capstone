# Copie ce fichier en ".env" et colle ta clé Pexels gratuite ci-dessous
# (obtenue sur https://www.pexels.com/api/)
PEXELS_API_KEY=colle_ta_cle_ici

# Connexion Google (Google Identity Services) - Client ID OAuth Web,
# cree sur https://console.cloud.google.com/
GOOGLE_CLIENT_ID=colle_ton_client_id_ici

# Supabase Storage : permet de conserver data.json (utilisateurs, avis,
# itineraires...) en dehors du disque local de Render, qui est efface a
# chaque redeploiement / reveil sur le plan gratuit. Facultatif : si ces
# variables sont absentes, l'app continue de fonctionner avec le fichier
# local uniquement (comportement precedent).
SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_SECRET_KEY=colle_ta_cle_secrete_ici
SUPABASE_BUCKET=globetrotter-data
